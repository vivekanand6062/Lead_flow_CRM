# ==============================================================================
# LeadFlow CRM — Backend Environment Template (.env.example)
# ==============================================================================

# Server Port
PORT=5000

# Environment Mode (development / production)
NODE_ENV=development

# PostgreSQL Connection String (e.g. Neon, Supabase, RDS, or local PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# JWT Authentication Secret & Expiration
JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRES_IN="7d"

# Google Gemini API Key for AI Sales Copilot (Optional)
# If provided, LeadFlow uses Gemini 1.5 Flash for live lead scoring, summaries, and follow-up drafts.
# If omitted or offline, a built-in heuristic AI engine handles scoring and generation seamlessly.
GEMINI_API_KEY="your_gemini_api_key_here"
